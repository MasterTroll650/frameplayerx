[Desktop Entry]
Type=Application
Name=Install FramePlayerX
Comment=Installs the latest FramePlayerX on this Steam Frame and adds it to the Steam library
Icon=system-software-install
Exec=konsole --hold -e sh -c "curl -fsSL https://github.com/remotesojourner/frameplayerx/releases/latest/download/frameplayerx-desktop-install.py -o /tmp/frameplayerx-desktop-install.py && python3 /tmp/frameplayerx-desktop-install.py"
Terminal=false
